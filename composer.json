{
    "name": "jundayw/laravel-proxy-manager",
    "version": "0.0.0",
    "description": "Proxy Manager integration for Laravel.",
    "keywords": [
        "AOP",
        "dynamic proxies",
        "aspect-oriented programming",
        "laravel-proxy-manager"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/jundayw/laravel-proxy-manager",
    "authors": [
        {
            "name": "Mr.Moore",
            "email": "jundayw@126.com"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "annotation/larscan": "^1.1",
        "jundayw/proxy": "^0.1.0"
    },
    "require-dev": {
        "code-lts/doctum": "^5.0",
        "jundayw/composer-version-plugin": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Jundayw\\ProxyManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs": "@php vendor/bin/doctum.php update doctum.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Jundayw\\ProxyManager\\ProxyManagerServiceProvider"
            ],
            "aliases": {
                "Proxy": "Jundayw\\ProxyManager\\Facades\\Proxy"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "jundayw/composer-version-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
